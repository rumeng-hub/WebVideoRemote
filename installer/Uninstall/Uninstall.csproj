<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>WebVideoRemoteUninstall</AssemblyName>
    <RootNamespace>WebVideoRemote</RootNamespace>
    <ApplicationManifest>..\app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <Product>网页视频遥控器 卸载程序</Product>
    <AssemblyTitle>网页视频遥控器 卸载程序</AssemblyTitle>
    <Company>WebVideoRemote</Company>
    <Version>2.0.0</Version>
    <DebugType>none</DebugType>
    <CodePage>65001</CodePage>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Theme.cs" Link="Theme.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\app.ico" LogicalName="Setup.app.ico" />
  </ItemGroup>

</Project>
