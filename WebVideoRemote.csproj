<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net8 + windows10 TFM：self-contained 发布后目标机器无需装任何 .NET 运行时；
         WinRT（SMTC 媒体控制）由内置 CsWinRT 投影提供，不再需要手动引用 Windows.winmd -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WebVideoRemote</AssemblyName>
    <RootNamespace>WebVideoRemote</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Deterministic>true</Deterministic>
    <Platforms>AnyCPU</Platforms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>build\</OutputPath>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Product>网页视频遥控器</Product>
    <AssemblyTitle>网页视频遥控器</AssemblyTitle>
    <Company>WebVideoRemote</Company>
    <Version>2.0.0</Version>
    <!-- 源码是 UTF-8，显式告诉编译器，避免中文变成乱码 -->
    <CodePage>65001</CodePage>
    <ApplicationManifest>src\app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 只内嵌程序图标（窗口/托盘/文件图标必需）。
         主视觉与角色立绘不放进 exe，安装时释放到 安装目录\assets\。 -->
    <EmbeddedResource Include="assets\app.ico" />
  </ItemGroup>

</Project>
