<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WebVideoRemote</AssemblyName>
    <RootNamespace>WebVideoRemote</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Deterministic>true</Deterministic>
    <Platforms>AnyCPU</Platforms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>build\</OutputPath>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Product>网页视频遥控器</Product>
    <AssemblyTitle>网页视频遥控器</AssemblyTitle>
    <Company>WebVideoRemote</Company>
    <Version>1.0.0</Version>
    <!-- 源码是 UTF-8，显式告诉编译器，避免中文变成乱码 -->
    <CodePage>65001</CodePage>
    <ApplicationManifest>src\app.manifest</ApplicationManifest>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 把桥接扩展内嵌进 exe：即使只拷了 exe 出来，也能一键释放并安装 -->
    <EmbeddedResource Include="extension\manifest.json" />
    <EmbeddedResource Include="extension\content.js" />
    <EmbeddedResource Include="extension\background.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows 系统媒体控制（SMTC）WinRT 元数据 -->
    <Reference Include="Windows">
      <HintPath>C:\Program Files (x86)\Windows Kits\10\UnionMetadata\10.0.26100.0\Windows.winmd</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Runtime.WindowsRuntime">
      <HintPath>C:\Windows\Microsoft.NET\Framework64\v4.0.30319\System.Runtime.WindowsRuntime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
