<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net8 + windows10 TFM：self-contained 发布后目标机器无需装任何 .NET 运行时；
         WinRT（SMTC 媒体控制）由内置 CsWinRT 投影提供，不再需要手动引用 Windows.winmd -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WebVideoRemote</AssemblyName>
    <RootNamespace>WebVideoRemote</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Deterministic>true</Deterministic>
    <Platforms>AnyCPU</Platforms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>build\</OutputPath>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Product>网页视频遥控器</Product>
    <AssemblyTitle>网页视频遥控器</AssemblyTitle>
    <Company>WebVideoRemote</Company>
    <Version>1.10.0</Version>
    <!-- 源码是 UTF-8，显式告诉编译器，避免中文变成乱码 -->
    <CodePage>65001</CodePage>
    <ApplicationManifest>src\app.manifest</ApplicationManifest>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 把桥接扩展内嵌进 exe：即使只拷了 exe 出来，也能一键释放并安装 -->
    <EmbeddedResource Include="extension\manifest.json" />
    <EmbeddedResource Include="extension\content.js" />
    <EmbeddedResource Include="extension\background.js" />
    <EmbeddedResource Include="extension\options.html" />
    <EmbeddedResource Include="extension\options.js" />
  </ItemGroup>

</Project>
